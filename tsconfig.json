{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "strict": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@frontend-css/*": ["frontend/css/*"],
      "@apps/*": ["frontend/apps/*"],
      "@frontend/*": ["frontend/js/*"],
      "vue": ["tooling/vite/node_modules/vue"]
    },
    "types": []
  },
  "include": [
    "frontend/js/**/*.ts",
    "frontend/js/**/*.vue",
    "frontend/apps/**/*.ts",
    "frontend/apps/**/*.vue",
    "tooling/vite/src/entry/**/*.ts",
    "tooling/vite/src/env.d.ts"
  ],
  "exclude": [
    "frontend/dist",
    "tooling/vite/node_modules",
    "tests/node_modules"
  ]
}
